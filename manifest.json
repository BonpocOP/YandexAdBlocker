{
  "manifest_version": 3,
  "name": "Yandex Games AdBlocker",
  "version": "1.0.0",
  "description": "Убирает рекламу на Яндекс.Играх и растягивает игру на освободившееся место.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://yandex.ru/games/*",
    "*://yandex.com/games/*",
    "*://*.yandex.ru/games/*",
    "*://games.s3.yandex.net/*",
    "*://*.games.s3.yandex.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Yandex Games AdBlocker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://yandex.ru/games/*",
        "*://yandex.com/games/*",
        "*://*.yandex.ru/games/*",
        "*://games.s3.yandex.net/*",
        "*://*.games.s3.yandex.net/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/blocker.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://yandex.ru/games/*",
        "*://yandex.com/games/*",
        "*://*.yandex.ru/games/*",
        "*://games.s3.yandex.net/*",
        "*://*.games.s3.yandex.net/*"
      ],
      "js": ["src/sdk-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
